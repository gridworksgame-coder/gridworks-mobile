{
  "name": "GRIDWORKS",
  "short_name": "GRIDWORKS",
  "description": "GRIDWORKS power grid simulation — mobile",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "landscape",
